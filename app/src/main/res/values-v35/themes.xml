<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15: tetap pakai tata letak lama agar keyboard tidak menutupi
         isian jawaban (bilah sistem disembunyikan saat ujian). -->
    <style name="Theme.CBTTeladan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
